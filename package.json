{
  "name": "filmscraper",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Aggregate nearby movie screenings into a markdown table",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.12.3",
  "bin": {
    "filmscraper": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && pnpm --filter filmscraper-web build",
    "scrape": "tsx src/cli.ts",
    "dev": "pnpm --filter filmscraper-web dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && pnpm --filter filmscraper-web typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "publish:data": "tsx src/publish.ts"
  },
  "dependencies": {
    "@netlify/blobs": "^10.7.12",
    "commander": "^12.1.0",
    "linkedom": "^0.18.5",
    "playwright": "^1.62.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vitest": "^2.1.8"
  }
}
